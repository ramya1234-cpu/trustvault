# TrustVault Environment Variables Configuration
# Copy this file to .env and configure values for your environment.

# PostgreSQL database connection URL (using psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://trustvault_app:local_dev_only_change_me@127.0.0.1:5433/trustvault

# Secret key for JWT signature generation and validation (must be at least 32 characters)
JWT_SECRET=replace_this_with_a_secure_random_key_of_at_least_32_characters
